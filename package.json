{
  "name": "paperclip-custom-adapter",
  "version": "0.1.4",
  "type": "module",
  "license": "MIT",
  "description": "Paperclip adapter for custom OpenAI-compatible, OpenAI Responses, and Anthropic-compatible LLM endpoints",
  "author": {
    "name": "Ehsanghaffar",
    "url": "https://eindev.ir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehsanghaffar/paperclip-agent-adapter.git",
    "directory": "packages/adapters/custom"
  },
  "bugs": {
    "url": "https://github.com/ehsanghaffar/paperclip-agent-adapter/issues"
  },
  "keywords": [
    "paperclip",
    "adapter",
    "llm",
    "custom-adapter",
    "anthropic",
    "custom"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "paperclip": {
    "adapterUiParser": "1.0.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./ui": "./dist/ui-parser.js",
    "./ui-parser": "./dist/ui-parser.js",
    "./cli": "./dist/cli/index.js"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "^2026.916.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  },
  "files": [
    "dist"
  ]
}
